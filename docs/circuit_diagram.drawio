              <mxPoint x="1467" y="440" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- =============================================================== -->
        <!-- COLOR CODING LEGEND                                            -->
        <!-- =============================================================== -->
        <mxCell id="grp_legend" value="&lt;b&gt;WIRING COLOR CODE KEY&lt;/b&gt;&lt;br&gt;&lt;table style=&quot;width:100%; font-size:10px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;color:#dc2626;&quot;&gt;&lt;b&gt;■ RED (Thick)&lt;/b&gt;: Battery + (7.4V - 11.1V High Current)&lt;/td&gt;&lt;td style=&quot;color:#ea580c;&quot;&gt;&lt;b&gt;■ ORANGE&lt;/b&gt;: Regulated 5.0V Logic Rail&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;color:#0f172a;&quot;&gt;&lt;b&gt;■ BLACK (Thick)&lt;/b&gt;: Common Ground (GND Bus)&lt;/td&gt;&lt;td style=&quot;color:#16a34a;&quot;&gt;&lt;b&gt;■ GREEN&lt;/b&gt;: Motor Drive High Current Outputs&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;color:#0284c7;&quot;&gt;&lt;b&gt;■ BLUE&lt;/b&gt;: Digital Direction &amp;amp; PWM Signals&lt;/td&gt;&lt;td style=&quot;color:#9333ea;&quot;&gt;&lt;b&gt;■ PURPLE&lt;/b&gt;: Bluetooth Serial Data Lines (TX/RX)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="840" width="1530" height="60" as="geometry" />
