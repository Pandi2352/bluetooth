  <diagram id="circuit_rc_car_uno_bt" name="4WD RC Car Arduino Uno + L298N + Bluetooth Circuit">
    <mxGraphModel dx="1422" dy="880" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" background="#f8fafc" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title Block -->
        <mxCell id="title_banner" value="&lt;b style=&quot;font-size: 20px;&quot;&gt;4WD RC CAR - COMPLETE HARDWARE CIRCUIT SCHEMATIC&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px; color: #64748b;&quot;&gt;Arduino Uno • L298N Driver (ENA/ENB Jumpers ON) • HC-05 Bluetooth (D3/D4) • Buck Converter (5V) • 2S Li-ion (7.4V) • 2A Switch&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="1530" height="70" as="geometry" />
        </mxCell>

        <!-- =============================================================== -->
        <!-- 1. POWER SUBSYSTEM (BATTERY + SWITCH + BUCK CONVERTER)         -->
        <!-- =============================================================== -->
        <mxCell id="grp_power" value="1. POWER SUBSYSTEM (2S Li-ion 7.4V - 8.4V)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontStyle=1;startSize=26;fontSize=13;fontColor=#991b1b;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="360" height="300" as="geometry" />
        </mxCell>

        <mxCell id="bat_pack" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;2x 18650 Li-ion Cells&lt;/b&gt;&lt;br&gt;Wired in Series (7.4V - 8.4V)&lt;br&gt;&lt;span style=&quot;color: #dc2626;&quot;&gt;(+) 7.4V Terminal&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: #1e293b;&quot;&gt;(-) Common GND Terminal&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#f87171;strokeWidth=1.5;" vertex="1" parent="grp_power">
          <mxGeometry x="20" y="40" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="pwr_switch" value="&lt;b&gt;2A Master Switch&lt;/b&gt;&lt;br&gt;SPST Rocker/Toggle&lt;br&gt;&lt;span style=&quot;font-size:9px; color:#854d0e;&quot;&gt;In-line on Battery (+)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef08a;strokeColor=#ca8a04;strokeWidth=1.5;fontSize=11;" vertex="1" parent="grp_power">
          <mxGeometry x="230" y="50" width="110" height="60" as="geometry" />
        </mxCell>

        <mxCell id="wire_bat_sw" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#dc2626;strokeWidth=3;" edge="1" parent="grp_power" source="bat_pack" target="pwr_switch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="buck_converter" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;DC-DC BUCK CONVERTER (LM2596 / MP1584)&lt;/b&gt;&lt;br&gt;&lt;table style=&quot;width:100%; font-size:10px; margin-top:4px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;color:#dc2626;&quot;&gt;&lt;b&gt;IN+&lt;/b&gt;: From Switch (+7.4V)&lt;/td&gt;&lt;td style=&quot;color:#ea580c;&quot;&gt;&lt;b&gt;OUT+&lt;/b&gt;: Regulated +5.0V Output&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;color:#0f172a;&quot;&gt;&lt;b&gt;IN-&lt;/b&gt;: Common GND&lt;/td&gt;&lt;td style=&quot;color:#0f172a;&quot;&gt;&lt;b&gt;OUT-&lt;/b&gt;: Common GND&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;span style=&quot;font-size:9px; color:#b91c1c;&quot;&gt;⚠️ Tune trimpot to EXACTLY 5.0V with multimeter BEFORE connecting!&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#f97316;strokeWidth=1.5;" vertex="1" parent="grp_power">
          <mxGeometry x="20" y="145" width="320" height="90" as="geometry" />
        </mxCell>

        <mxCell id="wire_sw_buck" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;strokeColor=#dc2626;strokeWidth=3;" edge="1" parent="grp_power" source="pwr_switch" target="buck_converter">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="pwr_notes" value="&lt;b&gt;Power Separation:&lt;/b&gt; High current 7.4V directly drives L298N 12V terminal. The buck converter outputs clean 5.0V for Uno 5V, L298N 5V, and HC-05." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#7f1d1d;" vertex="1" parent="grp_power">
          <mxGeometry x="20" y="245" width="320" height="40" as="geometry" />
        </mxCell>

        <!-- =============================================================== -->
        <!-- 2. L298N MOTOR DRIVER MODULE                                   -->
        <!-- =============================================================== -->
        <mxCell id="grp_l298n" value="2. L298N DUAL H-BRIDGE MOTOR DRIVER" style="swimlane;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=2;fontStyle=1;startSize=26;fontSize=13;fontColor=#1e40af;" vertex="1" parent="1">
          <mxGeometry x="470" y="130" width="450" height="420" as="geometry" />
        </mxCell>

        <mxCell id="l298_out12" value="&lt;b&gt;OUT 1 &amp;amp; OUT 2&lt;/b&gt;&lt;br&gt;(Left Motors Channel)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#60a5fa;strokeWidth=1.5;fontSize=11;" vertex="1" parent="grp_l298n">
          <mxGeometry x="20" y="45" width="130" height="50" as="geometry" />
        </mxCell>

        <mxCell id="l298_out34" value="&lt;b&gt;OUT 3 &amp;amp; OUT 4&lt;/b&gt;&lt;br&gt;(Right Motors Channel)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#60a5fa;strokeWidth=1.5;fontSize=11;" vertex="1" parent="grp_l298n">
          <mxGeometry x="300" y="45" width="130" height="50" as="geometry" />
        </mxCell>

        <mxCell id="l298_pwr_block" value="&lt;b&gt;POWER TERMINAL BLOCK&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#dc2626;&quot;&gt;[ +12V Terminal ]&lt;/b&gt; &amp;lt;-- From Switch (+7.4V)&lt;br&gt;&lt;b style=&quot;color:#0f172a;&quot;&gt;[ GND Terminal ]&lt;/b&gt; &amp;lt;-- Common GND Bus&lt;br&gt;&lt;b style=&quot;color:#ea580c;&quot;&gt;[ +5V Terminal ]&lt;/b&gt; &amp;lt;-- From Buck 5.0V Out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="grp_l298n">
          <mxGeometry x="20" y="115" width="240" height="75" as="geometry" />
        </mxCell>

        <mxCell id="l298_jumper" value="&lt;b&gt;5V-EN JUMPER&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#dc2626;&quot;&gt;REMOVE THIS JUMPER!&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;Feeding 5V from Buck converter avoids unreliable onboard regulator&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#eab308;strokeWidth=1.5;fontSize=10;" vertex="1" parent="grp_l298n">
          <mxGeometry x="275" y="115" width="155" height="75" as="geometry" />
        </mxCell>

        <!-- ENA & ENB Jumpers Kept ON -->
        <mxCell id="l298_ena_enb" value="&lt;b style=&quot;color:#16a34a;&quot;&gt;ENA &amp;amp; ENB JUMPERS: KEEP ON BOARD&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;&quot;&gt;Full speed drive; no PWM wiring required!&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;strokeWidth=1.5;fontSize=11;" vertex="1" parent="grp_l298n">
          <mxGeometry x="20" y="210" width="410" height="40" as="geometry" />
        </mxCell>

        <!-- Logic Direction Inputs -->
        <mxCell id="l298_logic_header" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;DIRECTION CONTROL HEADER (Connects to Uno)&lt;/b&gt;&lt;br&gt;&lt;table border=&quot;1&quot; style=&quot;width:100%; border-collapse:collapse; font-size:11px;&quot;&gt;&lt;tr style=&quot;background:#bfdbfe;&quot;&gt;&lt;th&gt;L298N Pin&lt;/th&gt;&lt;th&gt;Function&lt;/th&gt;&lt;th&gt;Arduino Uno Pin&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;IN1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Left Motors Forward&lt;/td&gt;&lt;td style=&quot;color:#2563eb;&quot;&gt;&lt;b&gt;Pin D7&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;IN2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Left Motors Reverse&lt;/td&gt;&lt;td style=&quot;color:#2563eb;&quot;&gt;&lt;b&gt;Pin D8&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;IN3&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Right Motors Forward&lt;/td&gt;&lt;td style=&quot;color:#2563eb;&quot;&gt;&lt;b&gt;Pin D9&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;IN4&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Right Motors Reverse&lt;/td&gt;&lt;td style=&quot;color:#2563eb;&quot;&gt;&lt;b&gt;Pin D10&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#93c5fd;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="grp_l298n">
          <mxGeometry x="20" y="265" width="410" height="135" as="geometry" />
        </mxCell>

        <!-- =============================================================== -->
        <!-- 3. 4X TT DC GEAR MOTORS                                        -->
        <!-- =============================================================== -->
        <mxCell id="grp_motors_left" value="LEFT MOTORS (Front + Rear in Parallel)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=1.5;startSize=24;fontSize=11;fontColor=#15803d;" vertex="1" parent="1">
          <mxGeometry x="60" y="450" width="360" height="140" as="geometry" />
        </mxCell>
        <mxCell id="m_fl" value="&lt;b&gt;Front-Left TT Motor&lt;/b&gt;&lt;br&gt;3V - 6V DC (1:48)&lt;br&gt;[ 0.1µF noise cap ]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#86efac;fontSize=10;" vertex="1" parent="grp_motors_left">
          <mxGeometry x="15" y="35" width="155" height="90" as="geometry" />
        </mxCell>
        <mxCell id="m_rl" value="&lt;b&gt;Rear-Left TT Motor&lt;/b&gt;&lt;br&gt;3V - 6V DC (1:48)&lt;br&gt;[ 0.1µF noise cap ]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#86efac;fontSize=10;" vertex="1" parent="grp_motors_left">
          <mxGeometry x="190" y="35" width="155" height="90" as="geometry" />
        </mxCell>

        <mxCell id="grp_motors_right" value="RIGHT MOTORS (Front + Rear in Parallel)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=1.5;startSize=24;fontSize=11;fontColor=#15803d;" vertex="1" parent="1">
          <mxGeometry x="60" y="610" width="360" height="140" as="geometry" />
        </mxCell>
        <mxCell id="m_fr" value="&lt;b&gt;Front-Right TT Motor&lt;/b&gt;&lt;br&gt;3V - 6V DC (1:48)&lt;br&gt;[ 0.1µF noise cap ]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#86efac;fontSize=10;" vertex="1" parent="grp_motors_right">
          <mxGeometry x="15" y="35" width="155" height="90" as="geometry" />
        </mxCell>
        <mxCell id="m_rr" value="&lt;b&gt;Rear-Right TT Motor&lt;/b&gt;&lt;br&gt;3V - 6V DC (1:48)&lt;br&gt;[ 0.1µF noise cap ]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#86efac;fontSize=10;" vertex="1" parent="grp_motors_right">
          <mxGeometry x="190" y="35" width="155" height="90" as="geometry" />
        </mxCell>

        <!-- Wires from L298N OUT to Motors -->
        <mxCell id="wire_l298_left" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#16a34a;strokeWidth=3;" edge="1" parent="1" source="l298_out12" target="grp_motors_left">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="wire_l298_right" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#16a34a;strokeWidth=3;" edge="1" parent="1" source="l298_out34" target="grp_motors_right">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Wire from Power Switch to L298N 12V -->
        <mxCell id="wire_sw_l298_12v" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#dc2626;strokeWidth=3;" edge="1" parent="1" source="pwr_switch" target="l298_pwr_block">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- =============================================================== -->
        <!-- 4. ARDUINO UNO MICROCONTROLLER BOARD                           -->
        <!-- =============================================================== -->
        <mxCell id="grp_uno" value="4. ARDUINO UNO (ATmega328P 16MHz)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#0284c7;strokeWidth=2;fontStyle=1;startSize=28;fontSize=13;fontColor=#0369a1;" vertex="1" parent="1">
          <mxGeometry x="970" y="130" width="310" height="580" as="geometry" />
        </mxCell>

        <!-- Uno Digital Control Pins -->
        <mxCell id="uno_pin_d3" value="&lt;b&gt;D3 (RX)&lt;/b&gt; &amp;lt;-- HC-05 TXD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ddd6fe;strokeColor=#c4b5fd;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="grp_uno">
          <mxGeometry x="15" y="55" width="135" height="30" as="geometry" />
        </mxCell>
        <mxCell id="uno_pin_d4" value="&lt;b&gt;D4 (TX)&lt;/b&gt; --&amp;gt; 1k/2k Divider" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ddd6fe;strokeColor=#c4b5fd;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="grp_uno">
          <mxGeometry x="15" y="105" width="135" height="30" as="geometry" />
        </mxCell>
        <mxCell id="uno_pin_d7" value="&lt;b&gt;D7&lt;/b&gt; --&amp;gt; L298N IN1 (L-Fwd)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#7dd3fc;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="grp_uno">
          <mxGeometry x="15" y="155" width="135" height="30" as="geometry" />
        </mxCell>
        <mxCell id="uno_pin_d8" value="&lt;b&gt;D8&lt;/b&gt; --&amp;gt; L298N IN2 (L-Rev)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#7dd3fc;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="grp_uno">
          <mxGeometry x="15" y="205" width="135" height="30" as="geometry" />
        </mxCell>
        <mxCell id="uno_pin_d9" value="&lt;b&gt;D9&lt;/b&gt; --&amp;gt; L298N IN3 (R-Fwd)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#7dd3fc;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="grp_uno">
          <mxGeometry x="15" y="255" width="135" height="30" as="geometry" />
        </mxCell>
        <mxCell id="uno_pin_d10" value="&lt;b&gt;D10&lt;/b&gt; --&amp;gt; L298N IN4 (R-Rev)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#7dd3fc;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="grp_uno">
          <mxGeometry x="15" y="305" width="135" height="30" as="geometry" />
        </mxCell>

        <!-- Uno Power Pins -->
        <mxCell id="uno_pin_5v" value="&lt;b&gt;5V Pin (VCC)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px; color:#b91c1c;&quot;&gt;From Buck 5.0V Out&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#fca5a5;fontSize=10;align=right;spacingRight=8;" vertex="1" parent="grp_uno">
          <mxGeometry x="160" y="45" width="135" height="40" as="geometry" />
        </mxCell>
        <mxCell id="uno_pin_gnd" value="&lt;b&gt;GND (Ground)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px; color:#1e293b;&quot;&gt;Common GND Bus&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#94a3b8;fontSize=10;align=right;spacingRight=8;" vertex="1" parent="grp_uno">
          <mxGeometry x="160" y="95" width="135" height="40" as="geometry" />
        </mxCell>

        <!-- Uno Control Wires to L298N -->
        <mxCell id="wire_uno_l298" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#0284c7;strokeWidth=2;" edge="1" parent="1" source="grp_uno" target="l298_logic_header">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Power 5V from Buck to Uno 5V and L298N 5V -->
        <mxCell id="wire_buck_5v" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#ea580c;strokeWidth=3;" edge="1" parent="1" source="buck_converter" target="uno_pin_5v">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="430" y="220" />
              <mxPoint x="430" y="110" />
              <mxPoint x="1200" y="110" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- =============================================================== -->
        <!-- 5. HC-05 BLUETOOTH MODULE & VOLTAGE DIVIDER                     -->
        <!-- =============================================================== -->
        <mxCell id="grp_hc05" value="5. HC-05 BLUETOOTH 2.0 (9600 BAUD)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#a855f7;strokeWidth=2;fontStyle=1;startSize=26;fontSize=13;fontColor=#6b21a8;" vertex="1" parent="1">
          <mxGeometry x="1330" y="130" width="260" height="290" as="geometry" />
        </mxCell>

        <mxCell id="hc05_vcc" value="&lt;b&gt;VCC&lt;/b&gt; (+5.0V from Buck)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#f472b6;fontSize=10;" vertex="1" parent="grp_hc05">
          <mxGeometry x="15" y="40" width="115" height="30" as="geometry" />
        </mxCell>
        <mxCell id="hc05_gnd" value="&lt;b&gt;GND&lt;/b&gt; (Common GND)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#94a3b8;fontSize=10;" vertex="1" parent="grp_hc05">
          <mxGeometry x="15" y="80" width="115" height="30" as="geometry" />
        </mxCell>
        <mxCell id="hc05_txd" value="&lt;b&gt;TXD&lt;/b&gt; --&amp;gt; Uno D3 (3.3V)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ddd6fe;strokeColor=#c4b5fd;fontSize=10;" vertex="1" parent="grp_hc05">
          <mxGeometry x="15" y="120" width="115" height="30" as="geometry" />
        </mxCell>
        <mxCell id="hc05_rxd" value="&lt;b&gt;RXD&lt;/b&gt; &amp;lt;-- From Divider" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ddd6fe;strokeColor=#c4b5fd;fontSize=10;" vertex="1" parent="grp_hc05">
          <mxGeometry x="15" y="160" width="115" height="30" as="geometry" />
        </mxCell>
        <mxCell id="hc05_state" value="&lt;b&gt;STATE&lt;/b&gt; (Leave open)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontSize=10;" vertex="1" parent="grp_hc05">
          <mxGeometry x="15" y="200" width="115" height="30" as="geometry" />
        </mxCell>
        <mxCell id="hc05_en" value="&lt;b&gt;EN / KEY&lt;/b&gt; (Leave open)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontSize=10;" vertex="1" parent="grp_hc05">
          <mxGeometry x="15" y="240" width="115" height="30" as="geometry" />
        </mxCell>

        <!-- Voltage Divider on HC-05 RX -->
        <mxCell id="grp_vdiv" value="&lt;b&gt;3.3V Divider&lt;/b&gt;&lt;br&gt;Uno D4 ──[1kΩ]──┬── RXD&lt;br&gt;                 │&lt;br&gt;               [2kΩ]&lt;br&gt;                 │&lt;br&gt;                GND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#d8b4fe;fontSize=10;" vertex="1" parent="grp_hc05">
          <mxGeometry x="140" y="115" width="105" height="110" as="geometry" />
        </mxCell>

        <!-- Wires between Uno and HC-05 -->
        <mxCell id="wire_hc05_tx_uno" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#9333ea;strokeWidth=2;" edge="1" parent="1" source="hc05_txd" target="uno_pin_d3">
