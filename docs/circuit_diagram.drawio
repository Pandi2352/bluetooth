        <!-- Wires between Nano and HC-05 -->
        <mxCell id="wire_hc05_tx_nano" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#9333ea;strokeWidth=2;" edge="1" parent="1" source="hc05_txd" target="nano_pin_d10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="wire_nano_div_hc05" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#9333ea;strokeWidth=2;" edge="1" parent="1" source="nano_pin_d11" target="grp_vdiv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- =============================================================== -->
        <!-- DUAL HEADLIGHTS (LEDS)                                         -->
        <!-- =============================================================== -->
        <mxCell id="grp_lights" value="DUAL HEADLIGHTS (Controlled via Bose Remote)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#eab308;strokeWidth=2;fontStyle=1;startSize=26;fontSize=13;fontColor=#854d0e;" vertex="1" parent="1">
          <mxGeometry x="1340" y="470" width="250" height="270" as="geometry" />
        </mxCell>

        <mxCell id="led_1" value="&lt;b&gt;HEADLIGHT 1 (Left)&lt;/b&gt;&lt;br&gt;White LED + 220Ω Resistor&lt;br&gt;&lt;b style=&quot;color:#ca8a04;&quot;&gt;Nano Pin D2&lt;/b&gt;&lt;br&gt;Remote: &#39;1&#39; = ON, &#39;0&#39; = OFF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef08a;strokeColor=#fde047;strokeWidth=1.5;fontSize=10;" vertex="1" parent="grp_lights">
          <mxGeometry x="15" y="40" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="led_2" value="&lt;b&gt;HEADLIGHT 2 (Right)&lt;/b&gt;&lt;br&gt;White LED + 220Ω Resistor&lt;br&gt;&lt;b style=&quot;color:#ca8a04;&quot;&gt;Nano Pin D3&lt;/b&gt;&lt;br&gt;Remote: &#39;2&#39; = ON, &#39;3&#39; = OFF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef08a;strokeColor=#fde047;strokeWidth=1.5;fontSize=10;" vertex="1" parent="grp_lights">
          <mxGeometry x="15" y="150" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- Wires from Nano D2 & D3 to LEDs -->
        <mxCell id="wire_nano_led1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#ca8a04;strokeWidth=2;" edge="1" parent="1" source="nano_pin_d2" target="led_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="wire_nano_led2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#ca8a04;strokeWidth=2;" edge="1" parent="1" source="nano_pin_d3" target="led_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- =============================================================== -->
        <!-- COMMON GROUND BUS (GND) BAR                                    -->
        <!-- =============================================================== -->
        <mxCell id="bus_gnd" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;COMMON GROUND BUS (Tied together: Battery (-) • L298N GND • Arduino GND • HC-05 GND • LED Cathodes)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#334155;strokeColor=#1e293b;strokeWidth=2;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="780" width="1530" height="40" as="geometry" />
        </mxCell>

        <!-- Ground connections to bus -->
        <mxCell id="wire_gnd_bat" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.1;entryY=0;entryDx=0;entryDy=0;strokeColor=#0f172a;strokeWidth=3;" edge="1" parent="1" source="bat_pack" target="bus_gnd">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="wire_gnd_l298" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.45;entryY=0;entryDx=0;entryDy=0;strokeColor=#0f172a;strokeWidth=3;" edge="1" parent="1" source="l298_pwr_block" target="bus_gnd">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="wire_gnd_nano" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.74;entryY=0;entryDx=0;entryDy=0;strokeColor=#0f172a;strokeWidth=3;" edge="1" parent="1" source="nano_pin_gnd" target="bus_gnd">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="wire_gnd_hc05" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.92;entryY=0;entryDx=0;entryDy=0;strokeColor=#0f172a;strokeWidth=3;" edge="1" parent="1" source="hc05_gnd" target="bus_gnd">
          <mxGeometry relative="1" as="geometry">
