        </mxCell>

        <mxCell id="pwr_notes" value="&lt;b&gt;Power Distribution Rules:&lt;/b&gt;&lt;br&gt;• Battery (+) connects to L298N 12V terminal via switch.&lt;br&gt;• Battery (-) connects to Common GND Bus.&lt;br&gt;• L298N onboard 5V regulator powers Arduino Nano 5V and HC-05 VCC." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#7f1d1d;" vertex="1" parent="grp_power">
          <mxGeometry x="15" y="140" width="310" height="70" as="geometry" />
        </mxCell>

