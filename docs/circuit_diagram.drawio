  <diagram id="circuit_rc_car_nano" name="4WD RC Car Complete Circuit Diagram">
    <mxGraphModel dx="1422" dy="880" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" background="#f8fafc" math="0" shadow="0">
      <root>
        <mxCell id="0" />
