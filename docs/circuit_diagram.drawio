        <!-- L298N Logic Inputs Header -->
        <mxCell id="l298_logic_header" value="&lt;b style=&quot;font-size: 12px;&quot;&gt;LOGIC CONTROL HEADER PINS&lt;/b&gt;&lt;br&gt;&lt;table border=&quot;1&quot; style=&quot;width:100%; border-collapse:collapse; font-size:10px;&quot;&gt;&lt;tr style=&quot;background:#bfdbfe;&quot;&gt;&lt;th&gt;Pin&lt;/th&gt;&lt;th&gt;Function&lt;/th&gt;&lt;th&gt;Connects to Nano&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;ENA&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Left Motors PWM Speed&lt;/td&gt;&lt;td style=&quot;color:#2563eb;&quot;&gt;&lt;b&gt;D5 (PWM)&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;IN1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Left Motors Forward&lt;/td&gt;&lt;td&gt;&lt;b&gt;D4&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;IN2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Left Motors Reverse&lt;/td&gt;&lt;td&gt;&lt;b&gt;D7&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;IN3&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Right Motors Forward&lt;/td&gt;&lt;td&gt;&lt;b&gt;D8&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;IN4&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Right Motors Reverse&lt;/td&gt;&lt;td&gt;&lt;b&gt;D12&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;ENB&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Right Motors PWM Speed&lt;/td&gt;&lt;td style=&quot;color:#2563eb;&quot;&gt;&lt;b&gt;D6 (PWM)&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#93c5fd;strokeWidth=1.5;align=center;verticalAlign=middle;" vertex="1" parent="grp_l298n">
