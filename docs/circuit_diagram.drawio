        <!-- Title Block -->
        <mxCell id="title_banner" value="&lt;b style=&quot;font-size: 20px;&quot;&gt;4WD SMART RC CAR - COMPLETE HARDWARE CIRCUIT SCHEMATIC&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px; color: #64748b;&quot;&gt;Arduino Nano • L298N Motor Driver • HC-05 Bluetooth Module • 4x TT DC Motors • Dual LED Lights • Bose Remote&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="1530" height="70" as="geometry" />
        </mxCell>

        <!-- =============================================================== -->
        <!-- POWER SUPPLY MODULE                                            -->
        <!-- =============================================================== -->
        <mxCell id="grp_power" value="POWER SUPPLY (2S / 3S Li-ion)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontStyle=1;startSize=26;fontSize=13;fontColor=#991b1b;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="340" height="230" as="geometry" />
        </mxCell>

        <mxCell id="bat_pack" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;18650 Li-ion Battery&lt;/b&gt;&lt;br&gt;2S (7.4V - 8.4V) or 3S (11.1V)&lt;br&gt;&lt;span style=&quot;color: #dc2626;&quot;&gt;(+) Positive Terminal&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: #1e293b;&quot;&gt;(-) Common Ground (GND)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#f87171;strokeWidth=1.5;" vertex="1" parent="grp_power">
          <mxGeometry x="20" y="40" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="pwr_switch" value="&lt;b&gt;Master Power Switch&lt;/b&gt;&lt;br&gt;SPST Rocker / Toggle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef08a;strokeColor=#ca8a04;strokeWidth=1.5;fontSize=11;" vertex="1" parent="grp_power">
          <mxGeometry x="230" y="55" width="90" height="50" as="geometry" />
        </mxCell>

        <mxCell id="wire_bat_sw" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#dc2626;strokeWidth=3;" edge="1" parent="grp_power" source="bat_pack" target="pwr_switch">
